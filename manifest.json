{
  "manifest_version": 3,
  "name": "Salasel Extension",
  "version": "1.0.0",
  "description": "Calm, intentional YouTube: hide distractions, take per-video notes, and resume your last Salasel playlist.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://salasel.app/*",
    "http://localhost:3000/*",
    "https://img.youtube.com/*",
    "https://i.ytimg.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "src/storage.js",
        "src/i18n.js",
        "src/styles/hide-rules.js",
        "src/content.js",
        "src/notes.js"
      ],
      "css": ["src/notes.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://salasel.app/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "src/storage.js",
        "src/salasel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["public/empty-home.html"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
